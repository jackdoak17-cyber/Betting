name: Build player fouls

on:
  # Daily at 01:10 UTC
  schedule:
    - cron: "10 1 * * *"
  workflow_dispatch: {}

permissions:
  contents: write

concurrency:
  group: player-stats-fouls
  cancel-in-progress: true

env:
  PYTHON_VERSION: "3.11"
  SPORTMONKS_TOKEN: ${{ secrets.SPORTMONKS_TOKEN }}
  SPORTMONKS_API_TOKEN: ${{ secrets.SPORTMONKS_TOKEN }}

jobs:
  build-player-fouls:
    runs-on: ubuntu-latest
    timeout-minutes: 240

    steps:
      - name: Checkout (shallow)
        uses: actions/checkout@v4
        with:
          fetch-depth: 1  # no full history

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install deps
        run: |
          set -e
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then
            pip install -r requirements.txt
          else
            pip install requests
          fi

      - name: Sanity check secret
        run: |
          if [ -z "${SPORTMONKS_TOKEN:-}" ]; then
            echo "ERROR: SPORTMONKS_TOKEN secret not available to job." >&2
            exit 1
          fi

      # ---------- Build fouls ----------
      - name: Build player fouls
        run: python scripts/player_fouls.py

      - name: Fouls coverage/summaries (if present)
        run: |
          [ -f scripts/check_player_fouls_coverage.py ] && python scripts/check_player_fouls_coverage.py || true
          [ - f scripts/render_player_fouls_summary.py ] && python scripts/render_player_fouls_summary.py || true

      # ---------- Commit & push ----------
      - name: Commit & push fouls data
        env:
          GIT_AUTHOR_NAME: github-actions[bot]
          GIT_AUTHOR_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
          GIT_COMMITTER_NAME: github-actions[bot]
          GIT_COMMITTER_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
        run: |
          set -euo pipefail

          git config user.name  "${GIT_COMMITTER_NAME}"
          git config user.email "${GIT_COMMITTER_EMAIL}"

          git add -A data/player_fouls || true
          git add -A data/player_* || true

          if git diff --staged --quiet; then
            echo "No fouls data changes to commit."
            exit 0
          fi

          ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
          git commit -m "chore(player-fouls): update ${ts}"

          # simple push, no history gymnastics
          git push origin HEAD:main
